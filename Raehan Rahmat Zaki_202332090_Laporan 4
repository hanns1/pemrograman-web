    <?php
    if ($_SERVER['REQUEST_METHOD'] === 'POST') {
        $nama = $_POST['nama'] ?? '';
        $nim = $_POST['nim'] ?? '';
        $kehadiran = $_POST['kehadiran'] ?? '';
        $tugas = $_POST['tugas'] ?? '';
        $uts = $_POST['uts'] ?? '';
        $uas = $_POST['uas'] ?? '';

        if ($nama === '' || $nim === '' || $kehadiran === '' || $tugas === '' || $uts === '' || $uas === '') {
            echo '<div class="alert alert-danger mt-3">Semua kolom <strong>WAJIB</strong> diisi</div>';
        } else {
            // Pastikan nilai numerik di-cast ke integer atau float sebelum perhitungan
            $kehadiran = (float) $kehadiran;
            $tugas = (float) $tugas;
            $uts = (float) $uts;
            $uas = (float) $uas;

            $nilaiAkhir = ($kehadiran * 0.1) + ($tugas * 0.2) + ($uts * 0.3) + ($uas * 0.4);

            if ($nilaiAkhir >= 85) $grade = 'A';
            elseif ($nilaiAkhir >= 70) $grade = 'B';
            elseif ($nilaiAkhir >= 55) $grade = 'C';
            elseif ($nilaiAkhir >= 40) $grade = 'D';
            else $grade = 'E';

            // Logika kelulusan yang diperbaiki
            $lulus = ($nilaiAkhir >= 60 && $kehadiran > 70 && $tugas >= 40 && $uts >= 40 && $uas >= 40);
            $status = ($kehadiran <= 70) ? 'TIDAK LULUS' : ($lulus ? 'LULUS' : 'TIDAK LULUS');

            $cardClass = $status == 'LULUS' ? 'border-success text-success' : 'border-danger text-danger';
            $btnClass = $status == 'LULUS' ? 'btn-success' : 'btn-danger';
    ?>
    <div class="card mt-4 <?= $cardClass ?>">
        <div class="card-header <?= $status == 'LULUS' ? 'bg-success' : 'bg-danger' ?> text-white">Hasil Penilaian</div>
        <div class="card-body">
            <h5 class="card-title">Nama: <?= htmlspecialchars($nama) ?></h5>
            <h6 class="card-subtitle mb-2">NIM: <?= htmlspecialchars($nim) ?></h6>
            <p class="card-text">Nilai Kehadiran: <?= htmlspecialchars($kehadiran) ?>%</p>
            <p class="card-text">Nilai Tugas: <?= htmlspecialchars($tugas) ?></p>
            <p class="card-text">Nilai UTS: <?= htmlspecialchars($uts) ?></p>
            <p class="card-text">Nilai UAS: <?= htmlspecialchars($uas) ?></p>
            <p class="card-text">Nilai Akhir: <?= number_format($nilaiAkhir, 2) ?></p>
            <p class="card-text">Grade: <?= $grade ?></p>
            <p class="card-text fw-bold">Status: <?= $status ?></p>
        </div>
        <div class="card-footer">
            <a href="<?= htmlspecialchars($_SERVER['PHP_SELF']) ?>" class="btn <?= $btnClass ?> w-100">Selesai</a>
        </div>
    </div>
